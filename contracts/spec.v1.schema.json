{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://crew.dev/contracts/spec.v1.schema.json",
  "title": "crew.spec/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "goal", "acceptance_criteria"],
  "properties": {
    "schema": { "const": "crew.spec/v1" },
    "goal": { "type": "string", "minLength": 1, "maxLength": 20000 },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text"],
        "properties": {
          "id": { "type": "string", "pattern": "^AC[0-9]+$" },
          "text": { "type": "string", "minLength": 1, "maxLength": 4000 },
          "verify": { "type": "string", "minLength": 1, "maxLength": 2000 }
        }
      }
    },
    "non_goals": {
      "type": "array",
      "maxItems": 50,
      "items": { "type": "string", "minLength": 1, "maxLength": 2000 }
    },
    "constraints": {
      "type": "array",
      "maxItems": 50,
      "items": { "type": "string", "minLength": 1, "maxLength": 2000 }
    }
  }
}
