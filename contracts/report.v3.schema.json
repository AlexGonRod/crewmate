{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://crew.dev/contracts/report.v3.schema.json",
  "title": "crew.report/v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "task_id", "run_id", "methodology", "role", "status", "summary"],
  "properties": {
    "schema": { "const": "crew.report/v3" },
    "task_id": { "type": "string", "pattern": "^tsk_[0-9A-Z]{26}$" },
    "run_id": { "type": "string", "pattern": "^run_[0-9A-Z]{26}$" },
    "methodology": {
      "type": "string",
      "enum": ["free", "spec", "tdd"]
    },
    "role": {
      "type": "string",
      "enum": ["developer", "tester"]
    },
    "verdict": {
      "type": "string",
      "enum": ["approve", "reject"]
    },
    "review_iteration": { "type": "integer", "minimum": 0 },
    "status": {
      "type": "string",
      "enum": ["done", "failed", "blocked", "needs_input", "progress"]
    },
    "summary": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "details": { "type": "string", "maxLength": 20000 },
    "acceptance": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion_id", "status", "evidence"],
        "properties": {
          "criterion_id": { "type": "string", "pattern": "^AC[0-9]+$" },
          "status": {
            "type": "string",
            "enum": ["passed", "failed", "not_verified"]
          },
          "evidence": { "type": "string", "minLength": 1, "maxLength": 4000 }
        }
      }
    },
    "findings": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "message"],
        "properties": {
          "severity": {
            "type": "string",
            "enum": ["blocking", "warning", "info"]
          },
          "message": { "type": "string", "minLength": 1, "maxLength": 4000 },
          "criterion_id": { "type": "string", "pattern": "^AC[0-9]+$" },
          "ref": { "type": "string", "minLength": 1, "maxLength": 2000 }
        }
      }
    },
    "tests": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "status"],
        "properties": {
          "command": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "status": {
            "type": "string",
            "enum": ["passed", "failed", "skipped", "unknown"]
          },
          "phase": {
            "type": "string",
            "enum": ["red", "green", "refactor"]
          },
          "duration_ms": { "type": "number", "minimum": 0 },
          "output": { "type": "string", "maxLength": 10000 }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "ref"],
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["commit", "pr", "file", "url", "other"]
          },
          "ref": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "label": { "type": "string", "maxLength": 500 }
        }
      }
    },
    "questions": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 200 },
          "text": { "type": "string", "minLength": 1, "maxLength": 4000 },
          "blocking": { "type": "boolean" }
        }
      }
    },
    "follow_ups": {
      "type": "array",
      "maxItems": 50,
      "items": { "type": "string", "minLength": 1, "maxLength": 2000 }
    }
  }
}
